{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-disallowed-list": [
      "/\\.operation-list\\s+button/",
      "/\\.operation-list\\s+>\\s+button/",
      "/\\.dashboard-refresh-action/",
      "/\\.operation-list\\s+button:hover/"
    ],
    "declaration-property-value-disallowed-list": {
      "/^line-height$/": [
        "/^[0-9.]+\\s*$/",
        "/^[0-9.]+(px|em|rem|%)/"
      ],
      "/^border-radius$/": [
        "/^[0-9]+(px|em|rem)$/"
      ],
      "/^(background|background-color|border|border-color|border-left-color|color|fill|stroke|outline-color|text-decoration-color)$/": [
        "/(^|[\\s,(])#[0-9a-fA-F]{3,8}\\b/",
        "/(^|[\\s,(])rgba?\\(/",
        "/var\\(--color-(void|carbon|obsidian|graphite|smoke|ash|fog|mist|bone|paper|acid-lime|pulse-green|coral-red|signal-teal|iris-violet|lavender)\\)/",
        "/var\\(--surface-(void|carbon|obsidian|slate)\\)/",
        "/var\\(--color-series-\\d\\)/",
        "/var\\(--font-inter-variable\\)/",
        "/var\\(--font-berkeley-mono\\)/",
        "/var\\(--font-display\\)/",
        "/var\\(--feedback-accent[\\w-]*\\)/"
      ]
    },
    "color-no-invalid-hex": true,
    "declaration-empty-line-before": null,
    "rule-empty-line-before": null,
    "no-descending-specificity": null,
    "value-keyword-case": null,
    "comment-empty-line-before": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "comment-whitespace-inside": null,
    "media-feature-range-notation": null,
    "color-hex-length": null,
    "selector-class-pattern": null,
    "declaration-block-no-shorthand-property-overrides": null
  },
  "ignoreFiles": ["**/__fixtures__/**"],
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "selector-class-pattern": null,
        "no-empty-source": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
